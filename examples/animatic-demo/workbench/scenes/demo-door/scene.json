  "script": {
    "version": 1,
    "lines": [
      {
        "line_id": "l01",
        "scene_id": "demo-door",
        "role_id": "photo",
        "text": "巷子里怎么这么安静。",
        "direction": "环顾"
      },
      {
        "line_id": "l02",
        "scene_id": "demo-door",
        "role_id": "wukong",
        "text": "师父说今晚要拍的就是这儿。",
        "direction": "蹲在墙头"
      },
      {
        "line_id": "l03",
        "scene_id": "demo-door",
        "role_id": "photo",
        "text": "你先下来，我去拿灯。"
      },
      {
        "line_id": "l04",
        "scene_id": "demo-door",
        "role_id": "wukong",
        "text": "灯不够亮的话，我可以变个大的。",
        "direction": "跳下"
      },
      {
        "line_id": "l05",
        "scene_id": "demo-door",
        "role_id": "photo",
        "text": "等等，那是什么声音？",
        "direction": "回头"
      },
      {
        "line_id": "l06",
        "scene_id": "demo-door",
        "role_id": "wukong",
        "text": "别动，有人在里面。",
        "direction": "警觉"
      },
      {
        "line_id": "l07",
        "scene_id": "demo-door",
        "role_id": "photo",
        "text": "要不要先报警？",
        "direction": "压低声音"
      },
      {
        "line_id": "l08",
        "scene_id": "demo-door",
        "role_id": "wukong",
        "text": "不用，看我的。"
      },
      {
        "line_id": "l09",
        "scene_id": "demo-door",
        "role_id": "photo",
        "text": "门开了——里面站着一个戴帽子的人。",
        "direction": "全景"
      },
      {
        "line_id": "l10",
        "scene_id": "demo-door",
        "role_id": "wukong",
        "text": "那是师父安排的内应。",
        "direction": "笑"
      }
    ]
  },
